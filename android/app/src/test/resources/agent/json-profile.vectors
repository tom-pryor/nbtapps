# Conformance cases for the strict JSON profile that manifest.json and the protocol's messages share
# (see the plan document, "Message reference", Common rules). Every parser of the project must agree with every
# line: tools/nbtpkg.py (tests/test_nbtpkg.py) and the agent's agent/json.cpp (tests/agent/test_json.cpp).
#
# A case is `ok` or `bad`, a space, and the input. %HH stands for the byte HH; a literal percent sign is %25. A note
# may follow two spaces and a #, since no input here holds that sequence.

# ---- Structure
ok {}
ok {"a":1}
ok %20{%09"a" : [ 1 , 2 ] ,%0D%0A "b" : { } } %0A  # the four JSON whitespace characters
ok {"":1}  # an empty key is a key
ok {"a":true,"b":false,"c":null}  # null parses; the message rules never send it
ok {"a":[],"b":[[]],"c":[{}]}
bad  # empty
bad %20%0A  # whitespace only
bad []  # top level must be an object
bad 1
bad "x"
bad null
bad true
bad {"a":1}}
bad {"a":1} x
bad {"a":1}{}
bad {"a":1}%00  # a NUL after the end
bad {"a":1
bad {"a":[1}
bad {"a":[1]
bad {"a":{]}
bad {"a":[1 2]}  # no comma
bad {"a":[1,]}  # trailing comma
bad {"a":[,1]}
bad {"a":1,}
bad {,"a":1}
bad {"a" 1}
bad {"a":}
bad {"a"}
bad {:1}
bad {a:1}
bad {'a':1}
bad {1:2}
bad {"a":1 "b":2}
bad {"a":1}//x  # no comments
bad {/*x*/"a":1}
bad {"a":1}%0C  # form feed is not JSON whitespace
bad {%0B"a":1}
bad {%C2%A0"a":1}  # nor is a no-break space
bad %EF%BB%BF{}  # byte-order mark

# ---- Duplicate keys
bad {"a":1,"a":2}
bad {"a":1,"b":2,"a":3}
bad {"x":{"b":1,"b":2}}  # in a nested object
bad {"x":[{"b":1,"b":2}]}
bad {"a":1,"\u0061":2}  # the same key once escaped
bad {"\u00e9":1,"%C3%A9":2}  # the same key escaped and as UTF-8
ok {"a":1,"A":2}  # keys are case-sensitive
ok {"x":{"a":1},"y":{"a":2}}  # the same key in two objects

# ---- Numbers: integers only, at most 2^53 - 1 in size
ok {"a":0}
ok {"a":-0}
ok {"a":-1}
ok {"a":9007199254740991}
ok {"a":-9007199254740991}
bad {"a":9007199254740992}
bad {"a":-9007199254740992}
bad {"a":123456789012345678901234567890}
bad {"a":1.0}
bad {"a":1.5}
bad {"a":1e3}
bad {"a":1E3}
bad {"a":1e-3}
bad {"a":1.}
bad {"a":.5}
bad {"a":01}
bad {"a":00}
bad {"a":-01}
bad {"a":-}
bad {"a":+1}
bad {"a":0x10}
bad {"a":1_000}
bad {"a":NaN}
bad {"a":Infinity}
bad {"a":-Infinity}

# ---- Literals
bad {"a":tru}
bad {"a":True}
bad {"a":TRUE}
bad {"a":nul}
bad {"a":falsey}
bad {"a":truefalse}

# ---- Strings
ok {"a":"\"\\\/\b\f\n\r\t"}  # every short escape
ok {"a":"\u0041\u00e9\u20AC"}  # hex digits in either case
ok {"a":"\ud83d\ude00"}  # a surrogate pair
ok {"a":"\u0000"}  # an escaped NUL is a character like any other
ok {"a":"%C3%A9%E2%82%AC%F0%9F%98%80"}  # UTF-8 of 2, 3 and 4 bytes
ok {"a":"%7F"}  # DEL needs no escape
ok {"a":"%F4%8F%BF%BF"}  # U+10FFFF
bad {"a":"x}
bad {"a":"x\"}
bad {"a":"%09x"}  # a raw tab
bad {"a":"x%0Ay"}  # a raw newline
bad {"a":"%00"}  # a raw NUL
bad {"a":"%1F"}
bad {"a":"\x41"}
bad {"a":"\a"}
bad {"a":"\u12"}
bad {"a":"\u12G4"}
bad {"a":"\U0041"}
bad {"a":"\u+041"}
bad {"a":"\ud800"}  # a high surrogate alone
bad {"a":"\udc00"}  # a low surrogate alone
bad {"a":"\udc00\ud800"}  # a pair the wrong way round
bad {"a":"\ud800\u0041"}
bad {"a":"\ud800x"}
bad {"\ud800":1}  # in a key too
bad {"a":"%FF"}
bad {"a":"%80"}  # a continuation byte alone
bad {"a":"%C3"}  # cut short
bad {"a":"%E2%82"}
bad {"a":"%C0%AF"}  # overlong
bad {"a":"%E0%80%AF"}  # overlong
bad {"a":"%F0%80%80%AF"}  # overlong
bad {"a":"%ED%A0%80"}  # a surrogate as UTF-8
bad {"a":"%F4%90%80%80"}  # above U+10FFFF
bad {"a":"%F8%88%80%80%80"}
bad {"%FF":1}

# ---- Nesting: at most 16 levels of objects and arrays
ok {"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{}}}}}}}}}}}}}}}}  # 16 objects
bad {"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{"a":{}}}}}}}}}}}}}}}}}  # 17 objects
ok {"a":[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]}  # an object and 15 arrays
bad {"a":[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]}  # an object and 16 arrays
bad {"a":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}  # deep enough to break a careless parser
