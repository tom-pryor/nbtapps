+++ b/src/scpmisc.c	2026-11-19 06:39:33.224774968 +0000
@@ -47,6 +47,24 @@
 #include "includes.h"
 #include "scpmisc.h"
 
+#ifdef __QNXNTO__
+/* QNX 6.5's libc has no vasprintf(). */
+static int
+vasprintf(char **out, const char *fmt, va_list ap)
+{
+	va_list ap2;
+	int n;
+
+	va_copy(ap2, ap);
+	n = vsnprintf(NULL, 0, fmt, ap2);
+	va_end(ap2);
+	*out = NULL;
+	if (n < 0 || (*out = malloc((size_t)n + 1)) == NULL)
+		return -1;
+	return vsnprintf(*out, (size_t)n + 1, fmt, ap);
+}
+#endif
+
 void *
 xmalloc(size_t size)
 {
