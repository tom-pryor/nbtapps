{
  "manifestVersion": 1,
  "id": "org.nbtapp.agent",
  "name": "NBTApp agent",
  "version": "@VERSION@",
  "requires": { "agent": ">=1.1.0" },
  "install": {
    "files": [
      { "src": "payload/nbtagent", "dest": "${app}/nbtagent", "mode": "0755" },
      { "src": "payload/nbtctl", "dest": "${app}/nbtctl", "mode": "0755" },
      { "src": "payload/nbtlaunch.sh", "dest": "${app}/nbtlaunch.sh", "mode": "0755" },
      { "src": "payload/nbtstart.sh", "dest": "${app}/nbtstart.sh", "mode": "0755" }
    ]
  }
}
