{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NBTApp package manifest, manifestVersion 1",
  "description": "manifest.json of a .nbtpkg. The file must also follow the strict JSON profile (UTF-8, no duplicate keys, integers only, at most 16 levels) and the cross-field rules that tools/nbtpkg.py checks: unique paths, every src and hook script listed in contents, a folder src with a folder dest, no destination placed twice, no serial service declared twice, no log path named twice, and for settings the rules of each option's type and the cross-field rules that $defs/setting gives. Unknown keys are refused inside requires and install, and ignored elsewhere.",
  "type": "object",
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "contents"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/packageId"
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/range"
        }
      }
    },
    "depends": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "contents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/content"
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "hooks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preInstall": {
              "$ref": "#/$defs/hook"
            },
            "postInstall": {
              "$ref": "#/$defs/hook"
            },
            "preRemove": {
              "$ref": "#/$defs/hook"
            },
            "postRemove": {
              "$ref": "#/$defs/hook"
            }
          }
        },
        "reboot": {
          "enum": [
            "none",
            "hmi-restart",
            "required"
          ]
        },
        "serialServices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serialService"
          }
        }
      }
    },
    "logs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/log"
      }
    },
    "settings": {
      "description": "The package's settings, which a phone shows and changes through the agent: the file they are kept in, one KEY=value a line, and the options. The object is open: keys other than file and options are ignored.",
      "type": "object",
      "required": [
        "options"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/settingsFile"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/setting"
          }
        }
      }
    }
  },
  "$defs": {
    "packageId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "range": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(>=|<=|>|<|=)?(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?( (>=|<=|>|<|=)?(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^(?!\\.{1,2}(/|$))[^/\\\\\\u0000-\\u001f]+(/(?!\\.{1,2}(/|$))[^/\\\\\\u0000-\\u001f]+)*$"
    },
    "dependency": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/packageId"
        },
        "version": {
          "$ref": "#/$defs/range"
        }
      }
    },
    "content": {
      "type": "object",
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967294
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "dest",
        "mode"
      ],
      "properties": {
        "src": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^(?!\\.{1,2}(/|$))[^/\\\\\\u0000-\\u001f]+(/(?!\\.{1,2}(/|$))[^/\\\\\\u0000-\\u001f]+)*/?$"
        },
        "dest": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^(\\$\\{(app|data|plugins)\\}/((?!\\.{1,2}(/|$))[^/\\\\\\u0000-\\u001f]+(/(?!\\.{1,2}(/|$))[^/\\\\\\u0000-\\u001f]+)*/?)?|(/(?!\\.{1,2}(/|$))[^/\\\\\\u0000-\\u001f]+)+/?)$"
        },
        "mode": {
          "type": "string",
          "pattern": "^0[0-7]{3}$"
        },
        "config": {
          "type": "boolean"
        },
        "replaces": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "target"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^(\\$\\{(app|data|plugins)\\})?(/(?!\\.{1,2}(/|$))[^/\\\\\\u0000-\\u001f]+)+$"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "timeout"
      ],
      "properties": {
        "script": {
          "$ref": "#/$defs/path"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "serialService": {
      "description": "A Bluetooth serial service that a program of the package registers with the car's Bluetooth stack while it runs: the name the registration is filed under, and the file name of the program. The agent removes the registration when that program is not running. The agent's own service name and the car's are not for a package.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "program"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(?!(NBTApp|SPP)$)[A-Za-z0-9_-]{1,32}$"
        },
        "program": {
          "type": "string",
          "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._+-]{1,64}$"
        }
      }
    },
    "logShape": {
      "description": "The shape of a logs entry's path that every reader of a manifest holds alike, whatever folders it knows: a variable ${name} or nothing, then segments that each start with a slash and are not empty, . or .., with no backslash or control character, the wildcards * and ? only in the last; never in the agent's own folders /tmp/nbtapp and /var/opt/nbtapp. A path of this shape that $defs/log/path refuses names a folder this schema does not know: nbtpkg.py refuses it, and the agent and the phone app take the manifest and skip the entry, so that a package that names a log in a folder a newer agent knows still installs on an older one. spec/log-paths.vectors has the cases. nbtpkg.py reads this from its code (log_path_form), as no member refers to it.",
      "type": "string",
      "maxLength": 255,
      "pattern": "^(?!/tmp/nbtapp(/|$))(?!/var/opt/nbtapp(/|$))(\\$\\{[a-z0-9_]+\\})?(/(?!\\.{1,2}(/|$))[^/\\\\\\u0000-\\u001f*?]+)*/(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001f]+$"
    },
    "log": {
      "description": "A log file of the package that a controller may pull from the head unit (files.list, files.fetch): one file, or the files of one folder that a wildcard in the last segment matches (* any characters, ? one). It is under ${app}, ${data} or ${tmp}, the package's own folder on the RAM disk; or an absolute path under /tmp or /var, but never the agent's own folders /tmp/nbtapp and /var/opt/nbtapp; or one file named in full in /dev/shmem, QNX's shared memory, with no folder under it and no wildcard, as other programs' shared objects are there. A path of the right shape ($defs/logShape) in another folder is refused here and skipped by the agent and the phone app. The object is open: keys other than path are ignored.",
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^((\\$\\{(app|data|tmp)\\}|/tmp(?!/nbtapp(/|$))|/var(?!/opt/nbtapp(/|$)))(/(?!\\.{1,2}(/|$))[^/\\\\\\u0000-\\u001f*?]+)*/(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001f]+|/dev/shmem/(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001f*?]+)$"
        }
      }
    },
    "settingsFile": {
      "description": "The file the settings are kept in: ${data}/ and a relative path, no slash at the end. ${data}/settings when absent.",
      "type": "string",
      "maxLength": 255,
      "pattern": "^\\$\\{data\\}/(?!\\.{1,2}(/|$))[^/\\\\\\u0000-\\u001f]+(/(?!\\.{1,2}(/|$))[^/\\\\\\u0000-\\u001f]+)*$"
    },
    "setting": {
      "description": "One option, as every reader takes it whatever its type. An option whose type is bool, int, text or select is then held to $defs/settingBool, settingInt, settingText or settingSelect, and to the cross-field rules: no key twice among the options (those of an unknown type included), not both default and unset, min no more than max, a default inside the option's limits, no select value twice, and at most 1024 bytes of UTF-8 in the option's strings (key, label, description, unset, an int's unit, a text's or select's default, and a select's values and their labels). An option of any other type is skipped: the package has no such setting, and of its members only key and label are looked at (and count toward the 1024 bytes). The object is open, and so is each type's: a key another type has, such as min on a bool, is ignored.",
      "type": "object",
      "required": [
        "key",
        "label",
        "type"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/settingKey"
        },
        "label": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "settingKey": {
      "description": "The name the option has in the settings file.",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "settingDescription": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "settingApplies": {
      "description": "When a change takes effect: at once, when the package's program next starts, when the HMI restarts, or when the head unit restarts. now when absent.",
      "enum": [
        "now",
        "app-start",
        "hmi-restart",
        "reboot"
      ]
    },
    "settingNumber": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "settingBool": {
      "description": "An option that is on or off. default is true or false.",
      "type": "object",
      "properties": {
        "description": {
          "$ref": "#/$defs/settingDescription"
        },
        "default": {
          "type": "boolean"
        },
        "unset": {
          "$ref": "#/$defs/name"
        },
        "applies": {
          "$ref": "#/$defs/settingApplies"
        },
        "advanced": {
          "type": "boolean"
        }
      }
    },
    "settingInt": {
      "description": "A whole number from min to max, both included; unit is shown beside it. default, when given, is inside those limits.",
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/settingDescription"
        },
        "min": {
          "$ref": "#/$defs/settingNumber"
        },
        "max": {
          "$ref": "#/$defs/settingNumber"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "default": {
          "$ref": "#/$defs/settingNumber"
        },
        "unset": {
          "$ref": "#/$defs/name"
        },
        "applies": {
          "$ref": "#/$defs/settingApplies"
        },
        "advanced": {
          "type": "boolean"
        }
      }
    },
    "settingText": {
      "description": "A text of 1 to maxLength bytes of UTF-8. With characters safe (the default) it holds only A-Z a-z 0-9 and . _ : / @ + , -; with any, no control character (U+0000 to U+001F, U+007F) and no space at its start or end. default, when given, is such a text.",
      "type": "object",
      "required": [
        "maxLength"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/settingDescription"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "characters": {
          "enum": [
            "safe",
            "any"
          ]
        },
        "default": {
          "type": "string"
        },
        "unset": {
          "$ref": "#/$defs/name"
        },
        "applies": {
          "$ref": "#/$defs/settingApplies"
        },
        "advanced": {
          "type": "boolean"
        }
      }
    },
    "settingSelect": {
      "description": "One of 2 to 16 values, each shown by its label. default, when given, is one of the values.",
      "type": "object",
      "required": [
        "values"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/settingDescription"
        },
        "values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/settingChoice"
          }
        },
        "default": {
          "type": "string"
        },
        "unset": {
          "$ref": "#/$defs/name"
        },
        "applies": {
          "$ref": "#/$defs/settingApplies"
        },
        "advanced": {
          "type": "boolean"
        }
      }
    },
    "settingChoice": {
      "description": "One value of a select option, as it stands in the settings file, and what a phone shows for it. The object is open.",
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "label": {
          "$ref": "#/$defs/name"
        }
      }
    }
  }
}
