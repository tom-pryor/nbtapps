{
  "manifestVersion": 1,
  "id": "org.nbtapp.agent",
  "name": "NBTApp agent",
  "version": "2.3.0",
  "requires": { "agent": ">=1.0.0" },
  "install": {
    "files": [
      { "src": "payload/nbtagent", "dest": "${app}/nbtagent", "mode": "0755" },
      { "src": "payload/menu.xml", "dest": "/opt/demo/agent-menu.xml", "mode": "0644" }
    ]
  }
}
