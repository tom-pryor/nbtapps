{
  "manifestVersion": 1,
  "id": "org.nbtapp.hello",
  "name": "Hello NBT",
  "version": "1.3.0",
  "requires": {
    "agent": ">=1.0.0"
  },
  "depends": [
    {
      "id": "org.nbtapp.runtime",
      "version": ">=2.0.0 <3.0.0"
    }
  ],
  "install": {
    "files": [
      {
        "src": "payload/bin/hello",
        "dest": "${app}/bin/hello",
        "mode": "0755"
      },
      {
        "src": "payload/lib/extra.txt",
        "dest": "${app}/lib/extra.txt",
        "mode": "0644"
      },
      {
        "src": "payload/etc/hello.conf",
        "dest": "${app}/etc/hello.conf",
        "mode": "0644",
        "config": true
      }
    ],
    "links": [
      {
        "path": "${app}/bin/hello-cli",
        "target": "../lib/extra.txt"
      },
      {
        "path": "${app}/bin/hello-new",
        "target": "hello"
      }
    ],
    "hooks": {
      "preInstall": {
        "script": "scripts/pre-install.sh",
        "timeout": 30
      },
      "postInstall": {
        "script": "scripts/post-install.sh",
        "timeout": 30
      }
    }
  }
}
