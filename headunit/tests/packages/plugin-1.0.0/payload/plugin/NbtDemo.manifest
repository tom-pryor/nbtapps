<?xml version="1.0" encoding="utf-8"?>
<plugin>
	<name>NbtDemo</name>
	<type>App</type>
	<file>{pluginDir}/NbtDemo</file>
	<config>
		<autoStart>yes</autoStart>
		<dependencies>
			<pluginAppConnector>
				<type>Etch</type>
				<id>250</id>
				<asyncCallbacks>yes</asyncCallbacks>
			</pluginAppConnector>
		</dependencies>
		<parameters>
			<DescFile>{pluginDir}/NbtDemo.xml</DescFile>
		</parameters>
	</config>
</plugin>
