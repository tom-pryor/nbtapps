{
  "manifestVersion": 1,
  "id": "org.nbtapp.prefail",
  "name": "Refusing hook",
  "version": "1.0.0",
  "install": {
    "files": [
      {
        "src": "payload/file.txt",
        "dest": "${app}/file.txt",
        "mode": "0644"
      }
    ],
    "hooks": {
      "preInstall": {
        "script": "scripts/pre-install.sh",
        "timeout": 10
      }
    }
  }
}
